# Production environment variables
# This file is used when running `npm run build`

# API Base URL for production on Hostinger VPS
REACT_APP_API_BASE_URL=https://msc-cert.com/api

# Cloudflare Turnstile site key (spam protection on public forms)
REACT_APP_TURNSTILE_SITE_KEY=0x4AAAAAAE2D6pBhj7gbb2Ta

# TypeScript compilation settings - allow build to continue with errors
TSC_COMPILE_ON_ERROR=true
ESLINT_NO_DEV_ERRORS=true
