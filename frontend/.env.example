# Example environment variables
# Copy this file to .env for local development

# API Base URL (required)
REACT_APP_API_BASE_URL=http://127.0.0.1:8000/api

# For production on Hostinger VPS:
# REACT_APP_API_BASE_URL=https://msc-cert.com/api

# Cloudflare Turnstile site key (spam protection on public forms)
# Get one at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave blank to disable the widget (forms still work, minus this layer of protection)
REACT_APP_TURNSTILE_SITE_KEY=
